{
  "name": "@basile/cli",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "description": "BASILE CLI — multi-stack audit runner",
  "license": "MIT",
  "author": "Cyril Pereira <https://github.com/funkymed>",
  "repository": "github:funkymed/basile",
  "homepage": "https://github.com/funkymed/basile#readme",
  "bugs": "https://github.com/funkymed/basile/issues",
  "keywords": [
    "audit",
    "security",
    "sast",
    "dast",
    "lighthouse",
    "cli",
    "phpstan",
    "semgrep",
    "bearer",
    "owasp",
    "wpscan",
    "trivy",
    "gitleaks",
    "zap"
  ],
  "bin": {
    "basile": "./dist/bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "oclif": {
    "bin": "basile",
    "dirname": "basile",
    "commands": "./dist/commands",
    "helpClass": "./dist/help",
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@basile/core": "workspace:*",
    "@basile/reporter-markdown": "workspace:*",
    "@basile/reporter-pdf": "workspace:*",
    "@basile/runner": "workspace:*",
    "@basile/scanner-composer-audit": "workspace:*",
    "@basile/scanner-eslint": "workspace:*",
    "@basile/scanner-lighthouse": "workspace:*",
    "@basile/scanner-phpcs": "workspace:*",
    "@basile/scanner-phpstan": "workspace:*",
    "@basile/scanner-wpscan": "workspace:*",
    "@basile/scanner-tsc": "workspace:*",
    "@basile/scanner-knip": "workspace:*",
    "@basile/scanner-depcheck": "workspace:*",
    "@basile/scanner-npm-audit": "workspace:*",
    "@basile/scanner-madge": "workspace:*",
    "@basile/scanner-semgrep": "workspace:*",
    "@basile/scanner-bearer": "workspace:*",
    "@basile/scanner-gitleaks": "workspace:*",
    "@basile/scanner-trivy": "workspace:*",
    "@basile/scanner-cloc": "workspace:*",
    "@basile/scanner-pa11y": "workspace:*",
    "@basile/scanner-zap-baseline": "workspace:*",
    "@basile/scanner-nuclei": "workspace:*",
    "@basile/scanner-headers": "workspace:*",
    "@basile/scanner-ssllabs-scan": "workspace:*",
    "@basile/scanner-testssl": "workspace:*",
    "@clack/prompts": "^0.7.0",
    "@oclif/core": "^4.0.0",
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "figlet": "^1.7.0",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
